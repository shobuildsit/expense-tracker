# Make.com Custom Webhook URL. Never hard-code this in watcher.py.
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

# Which sender to watch for.
# MESSAGE_FILTER_TYPE is sent to the webhook as-is (e.g. "email" or "sms").
# MESSAGE_FILTER_VALUE must match the sender exactly as Messages stores it:
#   - email (iMessage):  the address, e.g. you@example.com
#   - sms (short code):  the digits, e.g. 4444
MESSAGE_FILTER_TYPE=sms
MESSAGE_FILTER_VALUE=

# Optional overrides (defaults shown)
# MESSAGES_DB_PATH=~/Library/Messages/chat.db
# POLL_INTERVAL_SECONDS=5

# Set to "true" to log the webhook payload instead of actually sending it.
# Useful for testing without triggering the real Make scenario.
DRY_RUN=false

# Production behavior only targets received messages (is_from_me = 0).
# Set to "true" in local dev to also pick up messages you sent yourself
# (useful for testing the webhook without waiting for an inbound message).
# Keep "false" in production.
INCLUDE_FROM_ME=false
